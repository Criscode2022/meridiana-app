generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PreferredSlot {
  MORNING
  AFTERNOON
  ANY
}

enum AppointmentStatus {
  NEW
  CONTACTED
  CLOSED
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  summary     String
  description String
  iconKey     String   @default("care")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  appointments AppointmentRequest[]
}

model Doctor {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  fullName             String
  roleTitle            String
  bio                  String
  photoUrl             String
  acceptsAppointments  Boolean  @default(true)
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  appointments         AppointmentRequest[]
}

model AppointmentRequest {
  id                 String            @id @default(cuid())
  patientName        String
  phone              String
  email              String?
  preferredSlot      PreferredSlot     @default(ANY)
  preferredDoctorId  String?
  preferredDoctor    Doctor?           @relation(fields: [preferredDoctorId], references: [id])
  serviceId          String?
  service            Service?          @relation(fields: [serviceId], references: [id])
  reason             String
  status             AppointmentStatus @default(NEW)
  receptionNotes     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}
